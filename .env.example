# ---- Core ----
# Local dev (docker compose postgres):
DATABASE_URL="postgresql://nexa:nexa@localhost:5432/nexa_crm"
# Production (Neon example):
# DATABASE_URL="postgresql://user:pass@ep-xxxx.ap-southeast-2.aws.neon.tech/nexa_crm?sslmode=require"

# Public base URL of this app (used in outbound emails / private links / webhooks)
APP_BASE_URL="http://localhost:3000"

# better-auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Secret used to encrypt stored OAuth tokens and to sign internal calls
APP_SECRET="change-me-to-a-long-random-string"

# Shared secret for /api/internal/tick (GitHub Actions cron) and /api/n8n/*
INTERNAL_API_SECRET="change-me-to-a-long-random-string"
CRM_N8N_SECRET="change-me-to-a-long-random-string"

# ---- Providers (fill in when ready; app runs in labelled simulation mode without them) ----
# Google OAuth for the shared Gmail inbox (GCP console -> OAuth client, web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# DataForSEO (https://dataforseo.com) — pay-as-you-go SERP/business-listing data
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# OpenAI — used by the n8n article workflows
OPENAI_API_KEY=""

# SMS provider: "simulated" | "twilio" | "clicksend"
SMS_PROVIDER="simulated"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
CLICKSEND_API_KEY=""
CLICKSEND_USERNAME=""

# Mailgun (reserved — only needed once a sending domain exists)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_SIGNING_KEY=""

# n8n admin (dev only)
N8N_ADMIN_PASSWORD="changeme"
